# Server Configuration
PORT=8080
HOST=0.0.0.0

# Anthropic Claude API (Used for HyperFrames animation & GSAP kinetic code generation)
CLAUDE_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-sonnet-5-5

# OpenRouter API (Used for 3-scene story planning & sequential consistent image generation)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_STORY_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-lite-image

# ElevenLabs Speech-to-Text API (Optional fallback when transcript is not provided)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_STT_MODEL=scribe_v2

# Google Cloud Storage Configuration (Optional for cloud storage upload)
GOOGLE_CLOUD_PROJECT=musictovideo-prod
DEFAULT_OUTPUT_BUCKET=lyricvue_prod_free
TRANSCRIPTIONS_BUCKET_NAME=lyricvue_prod_free
